# 1 = block “Approve” until payment is Mark paid or Waive fee
REQUIRE_PAYMENT_FOR_APPROVAL="0"

# Snippe (mobile money USSD push + card). Get keys from https://snippe.sh dashboard.
SNIPPE_ENABLED="0"
SNIPPE_API_KEY=""
SNIPPE_API_BASE="https://api.snippe.sh"
# Webhook signing secret (Snippe dashboard → Settings → Webhook Secret). Must match or webhooks are rejected.
# Webhook URL to register in Snippe (if required): {APP_BASE_URL}/webhooks/snippe.php
SNIPPE_WEBHOOK_SECRET=""
