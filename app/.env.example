DB_HOST="127.0.0.1"
DB_PORT="3306"
DB_NAME="ardhi_guide_mvp"
DB_USER="root"
DB_PASS=""

WHATSAPP_DEFAULT_COUNTRY_CODE="255"
WHATSAPP_DEFAULT_NUMBER="255657925368"

