###############################################################################
# Ardhi Guide production .env (Evolution / cPanel shared hosting)
# Copy this file to `app/.env` on the server and fill in the real values.
# This file must NEVER be web-accessible. The bundled .htaccess rules block it.
###############################################################################

# Branding
APP_NAME="Ardhi Guide"

# Full public URL of the site, without a trailing slash.
APP_BASE_URL="https://ardhiguide.olamtec.co.tz"

# MySQL credentials provisioned in cPanel.
# DB_PASS is intentionally a placeholder; set the real value on the server
# (never commit the password to git).
DB_HOST="localhost"
DB_PORT="3306"
DB_NAME="olamtecc_ardhi_guide"
DB_USER="olamtecc_ardhi_guide"
DB_PASS="REPLACE_ON_SERVER"

# WhatsApp / phone contact used across the site (international format, no +)
WHATSAPP_DEFAULT_COUNTRY_CODE="255"
WHATSAPP_DEFAULT_NUMBER="255657925368"

# Session cookie name. Change this if you run multiple PHP apps under the same domain.
SESSION_NAME="ARDHI_GUIDE_SESSION"

# Optional: notify admin when a new listing is submitted (requires working PHP mail() or SMTP)
ADMIN_NOTIFY_EMAIL=""
MAIL_FROM="noreply@olamtec.co.tz"

# 1 = block "Approve" in admin until a listing's payment_status is `paid` or `waived`
REQUIRE_PAYMENT_FOR_APPROVAL="0"

# Snippe online payments (set SNIPPE_ENABLED=1 after adding real keys)
SNIPPE_ENABLED="1"
SNIPPE_API_KEY="REPLACE_FROM_SNIPPE_DASHBOARD"
SNIPPE_API_BASE="https://api.snippe.sh"
SNIPPE_WEBHOOK_SECRET="REPLACE_FROM_SNIPPE_DASHBOARD"
