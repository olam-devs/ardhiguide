# Project root .htaccess.
#
# Non-public folders (app/, database/, scripts/, storage/) each carry their
# own "Require all denied" .htaccess directly, rather than denying here and
# trying to override it deeper in the tree — a blanket deny at this level
# combined with per-file/per-directory overrides was unreliable on this
# hosting account's Apache config (overrides were not honored), so each
# private folder now protects itself independently instead.
#
# This root file only adds a defense-in-depth block on .env files anywhere
# in the tree, and lets index.php (a small redirect to /public/) execute.

<FilesMatch "(^\.env|^\.env\..*$|\.env\.example$|\.env\.production\.example$)">
    Require all denied
</FilesMatch>
